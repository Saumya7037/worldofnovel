# WorldofNovel environment variables
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to git.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/worldofnovel

# Backend port
PORT=4000

# Base URL of the frontend (used for CORS + Google OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Secret used to sign auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Cookie settings
COOKIE_SECURE=false

# Google OAuth (leave empty to run without Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Local uploads directory (relative to backend/)
UPLOAD_DIRECTORY=uploads